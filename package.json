{
	"name": "phaser3-parcel-template",
	"version": "1.0.0",
	"description": "A template project for Phaser3 using Parceljs",
	"scripts": {
		"start": "vite",
		"build": "vite build",
		"build:android": "vite build && npx cap sync android",
		"build:ios": "vite build && npx cap sync ios",
		"open:android": "npx cap open android",
		"open:ios": "npx cap open ios",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
		"typecheck:act2": "tsc -p tsconfig.act2.json",
		"sim:act2": "esbuild tools/act2/sim.ts --bundle --platform=node --outfile=node_modules/.cache/act2/sim.cjs --log-level=warning && node node_modules/.cache/act2/sim.cjs",
		"e2e:act2": "node tools/act2/e2e-smoke.mjs"
	},
	"author": "supertommy",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ourcade/phaser3-parcel-template.git"
	},
	"homepage": "https://github.com/ourcade/phaser3-parcel-template",
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^2.29.0",
		"@typescript-eslint/parser": "^2.29.0",
		"@vitest/coverage-v8": "^4.1.4",
		"eslint": "^6.8.0",
		"jsdom": "^28.1.0",
		"minimist": ">=1.2.2",
		"typescript": "^3.8.3",
		"vite": "^5.0.0",
		"vite-tsconfig-paths": "^4.0.0",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"@capacitor/android": "^8.3.0",
		"@capacitor/cli": "^8.3.0",
		"@capacitor/core": "^8.3.0",
		"@capacitor/ios": "^8.3.0",
		"@capacitor/screen-orientation": "^8.0.1",
		"@capacitor/splash-screen": "^8.0.1",
		"@capacitor/status-bar": "^8.0.2",
		"phaser": "^3.90.0"
	}
}
