{
	"compilerOptions": {
		"target": "es2016",
		"module": "es6",
		"moduleResolution": "node",
		"lib": ["es2017"],
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"baseUrl": "./src",
		"paths": {
			"~/*": ["./*"]
		},
		"types": []
	},
	"include": ["src/act2/core/**/*", "src/act2/app/**/*", "tools/act2/**/*"]
}
